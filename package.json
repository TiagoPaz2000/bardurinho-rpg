{
  "name": "bardurinho-rpg",
  "private": true,
  "version": "0.7.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:screenshots": "tsx tools/screenshots/test.ts",
    "screenshots": "tsx tools/screenshots/index.ts",
    "validate-content": "tsx tools/validate-content/index.ts",
    "icons": "tsx tools/icons/resize.ts",
    "icons:svg": "tsx tools/icons/svg.ts",
    "icons:sheet": "tsx tools/icons/sheet.ts",
    "lab": "npm run dev -w @bardurinho/combat-debug-lab",
    "web": "npm run dev -w @bardurinho/web",
    "optimize-models": "tsx tools/models/optimize.ts",
    "e2e:partida": "node tools/e2e/partida-ui.mjs",
    "server": "npm run dev -w @bardurinho/server",
    "e2e:rede": "tsx tools/e2e/rede.ts",
    "e2e:rede-ui": "tsx tools/e2e/rede-ui.ts",
    "e2e:conteudo": "tsx tools/e2e/conteudo.ts",
    "bots:sim": "tsx tools/bots/simulate.ts",
    "e2e:ciclo": "tsx tools/e2e/ciclo.ts",
    "perf:client": "tsx tools/perf/client.ts",
    "perf:assets": "tsx tools/perf/assets.ts",
    "batch:invariants": "tsx tools/batch/invariants.ts",
    "balance": "tsx tools/balance/index.ts",
    "perf:server": "tsx tools/perf/server.ts",
    "netsim": "tsx tools/perf/netsim.ts",
    "fuzz:server": "vitest run tests/integration/seguranca.test.ts",
    "regression:from-match": "tsx tools/regression/from-match.ts",
    "balance:difficulty": "tsx tools/balance/difficulty.ts",
    "build:web": "npm run build -w @bardurinho/web",
    "start:prod": "tsx tools/playtest/start.ts",
    "metrics:report": "tsx tools/playtest/report.ts",
    "playtest:invites": "tsx tools/playtest/invites.ts",
    "playtest:sim": "tsx tools/playtest/simulate.ts",
    "e2e:playtest": "tsx tools/e2e/playtest.ts"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.5.1",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@napi-rs/canvas": "^1.1.0",
    "@types/node": "^22.0.0",
    "meshoptimizer": "^1.2.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
