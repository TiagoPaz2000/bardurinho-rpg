{
  "name": "bardurinho-rpg",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:screenshots": "tsx tools/screenshots/test.ts",
    "screenshots": "tsx tools/screenshots/index.ts",
    "validate-content": "tsx tools/validate-content/index.ts",
    "icons": "tsx tools/icons/resize.ts",
    "lab": "npm run dev -w @bardurinho/combat-debug-lab",
    "web": "npm run dev -w @bardurinho/web",
    "optimize-models": "tsx tools/models/optimize.ts"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.5.1",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@napi-rs/canvas": "^1.1.0",
    "@types/node": "^22.0.0",
    "meshoptimizer": "^1.2.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
